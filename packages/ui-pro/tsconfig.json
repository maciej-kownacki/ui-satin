{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // The test helpers in test/satin.tsx (renderWithSatin, the axe check); Vitest resolves it the same way.
    "paths": { "satin-test": ["../../test/satin.tsx"] }
  },
  "include": ["src"]
}
