{
  "name": "@uisatin/ui",
  "version": "0.1.1",
  "description": "Satin Free: the open-source React components of the Satin design system. shadcn-based, built on Radix, themed with Satin tokens.",
  "license": "MIT",
  "author": "Maciej Kownacki",
  "homepage": "https://uisatin.dev",
  "keywords": [
    "satin",
    "design-system",
    "react",
    "components",
    "shadcn",
    "radix",
    "ui"
  ],
  "satin": {
    "edition": "free"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./theme.css": "./src/styles/theme.css",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && tailwindcss -i build/styles.css -o dist/styles.css --minify && node build/manifest.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"console.error('Publish the built package: npm run release (it publishes packages/ui/dist).'); process.exit(1)\""
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconoir-react": "^7.12.2",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
