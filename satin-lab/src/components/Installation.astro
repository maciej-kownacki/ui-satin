---
/**
 * Installation, between the Showcase and the API Reference: three numbered steps on a
 * vertical hairline. 1 links to the Installation page, 2 is the
 * shadcn command for this component's registry item (public/r/<id>.json, built by
 * `npm run registry`) and what it does, 3 is the Showcase's shortest example, with app imports.
 */
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import Chip from './Chip.astro'
import CodeFrame from './CodeFrame.astro'

interface Props {
  id: string
  title: string
}
const { id, title } = Astro.props

type RegistryItem = { name: string; dependencies?: string[]; registryDependencies?: string[] }
const dir = [join(process.cwd(), 'public/r'), join(process.cwd(), 'satin-lab/public/r')].find((d) => existsSync(d))
const read = (name: string): RegistryItem | undefined => {
  const file = dir && join(dir, `${name}.json`)
  return file && existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : undefined
}
const item = read(id)

const packages = (item?.dependencies ?? []).map((d) => d.replace(/(.)@.*$/, '$1'))
// Other Satin components this one is built from (chip → badge), and theirs, all the way down.
const nameOf = (url: string) => url.replace(/^.*\/r\//, '').replace(/\.json$/, '')
const used = new Set<string>()
const walk = (name: string) => {
  for (const dep of read(name)?.registryDependencies ?? []) {
    const n = nameOf(dep)
    if (n === 'utils' || n === 'satin-styles' || used.has(n)) continue
    used.add(n)
    walk(n)
  }
}
walk(id)
// The Showcase's shortest example (the simplest use), importing from the app's components/ui instead of the package.
const demos = import.meta.glob<{ options?: { code: string }[] }>('../demos/*.tsx')
const demo = demos[`../demos/${id}.tsx`] ? await demos[`../demos/${id}.tsx`]() : undefined
const example = [...(demo?.options ?? [])].sort((a, b) => a.code.length - b.code.length)[0]?.code.replaceAll("'@satin/ui/", "'@/components/ui/").replaceAll("'@satin/ui'", `'@/components/ui/${id}'`)
// Satin components the example imports beyond this one's own dependencies (Command menu's demo
// opens from a SearchBar): install them in the same command, so the example compiles as shown.
const extra = [...new Set([...(example ?? '').matchAll(/from '@\/components\/ui\/([\w-]+)'/g)].map((m) => m[1]))].filter(
  (n) => n !== id && !used.has(n) && read(n),
)
for (const n of extra) {
  used.add(n)
  walk(n)
}
const command = `npx shadcn@latest add ${[id, ...extra].map((n) => `https://uisatin.dev/r/${n}.json`).join(' ')}`
const files = [id, ...[...used].sort()].map((n) => `${n}.tsx`)
const usage = `// main.tsx, once for the whole app
import './styles/satin.css'

${example ?? `import { ${title.replace(/\s+(\w)/g, (_, c) => c.toUpperCase())} } from '@/components/ui/${id}'`}`

const list = (names: string[]) => names.map((n, i) => ({ n, sep: i === 0 ? '' : i === names.length - 1 ? ' and ' : ', ' }))
const step = 'relative grid grid-cols-[24px_minmax(0,1fr)] gap-x-4 pb-8 last:pb-0'
const marker =
  'relative z-10 grid size-6 place-items-center rounded-full border border-border-default bg-bg-card text-xs leading-4 font-medium text-text-default tabular-nums'
// The line runs from under one marker to just above the next; the last step has none.
const line = 'absolute top-8 bottom-2 left-[11.5px] w-px bg-border-subtle'
const stepTitle = 'pt-px text-base leading-6 font-medium text-text-default'
---

<section aria-labelledby="install-title" class="flex flex-col gap-4 pt-8">
  <h2 id="install-title" class="text-lg font-medium text-text-default">Installation</h2>
  <ol class="flex flex-col">
    <li class={step}>
      <span aria-hidden class={line}></span>
      <span aria-hidden class={marker}>1</span>
      <div class="flex min-w-0 flex-col gap-2">
        <h3 class={stepTitle}>Set up your project</h3>
        <p class="text-base leading-6 text-text-muted">
          You need React 19, TypeScript, the <Chip>@/</Chip> import alias and a <Chip>components.json</Chip>. No Tailwind. Follow the <a
            href="/installation"
            class="rounded-sm text-text-default underline underline-offset-2 focus-visible:shadow-border-focus focus-visible:outline-none">installation guide</a
          >.
        </p>
      </div>
    </li>
    <li class={step}>
      <span aria-hidden class={line}></span>
      <span aria-hidden class={marker}>2</span>
      <div class="flex min-w-0 flex-col gap-3">
        <h3 class={stepTitle}>Install the component and its dependencies</h3>
        <CodeFrame code={command} label="Terminal" lang="bash" copyLabel="Copy command" />
        <div class="flex flex-col gap-2 text-base leading-6 text-text-muted">
          <p>This command will:</p>
          <ul class="flex list-disc flex-col gap-1 pl-5 marker:text-text-subtle">
            {
              packages.length > 0 && (
                <li>
                  Install {list(packages).map(({ n, sep }) => (<>{sep}<Chip>{n}</Chip></>))} and add {packages.length > 1 ? 'them' : 'it'} to <Chip>package.json</Chip>
                </li>
              )
            }
            <li>
              Add {list(files).map(({ n, sep }) => (<>{sep}<Chip>{n}</Chip></>))} to <Chip>components/ui</Chip>
            </li>
            <li>
              Add <Chip>cn</Chip> to <Chip>lib/utils.ts</Chip> and Satin’s precompiled styles to <Chip>src/styles/satin.css</Chip>, if they aren’t there yet
            </li>
          </ul>
        </div>
      </div>
    </li>
    <li class={step}>
      <span aria-hidden class={marker}>3</span>
      <div class="flex min-w-0 flex-col gap-3">
        <h3 class={stepTitle}>Start using it</h3>
        <p class="text-base leading-6 text-text-muted">Import the styles once, then import {title} from your components.</p>
        <CodeFrame code={usage} label="Usage" />
      </div>
    </li>
  </ol>
</section>
