---
/**
 * A component page, laid out like the docs template (uiKit 3857:6009): name and description,
 * then the Showcase island (Preview / Code tabs, full screen, the stage), then the API Reference.
 */
import Chip from './Chip.astro'
import PageHeader from './PageHeader.astro'
import type { Api } from '../api'
import type { NavItem } from '../nav'

interface Props {
  item: NavItem
  api: Api
}
const { item, api } = Astro.props
const parts = api.description.split(/(`[^`]+`)/).filter(Boolean)
---

<PageHeader id={item.id} title={item.title} description={item.description} />

<slot />

<section aria-labelledby="api-title" class="flex flex-col gap-4 pt-8">
  <h2 id="api-title" class="text-lg font-medium text-text-default">API Reference</h2>
  <p class="text-base leading-6 text-text-muted">
    {parts.map((p) => (p.startsWith('`') ? <Chip>{p.slice(1, -1)}</Chip> : p))}
  </p>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[560px] border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-border-default">
          <th scope="col" class="w-[156px] py-2 pr-4 font-medium text-text-default">Prop</th>
          <th scope="col" class="py-2 pr-4 font-medium text-text-default">Type</th>
          <th scope="col" class="w-[140px] py-2 font-medium text-text-default">Default</th>
        </tr>
      </thead>
      <tbody>
        {
          api.props.map((prop) => (
            <tr class="border-b border-border-default align-top">
              <th scope="row" class="py-3 pr-4 font-normal">
                <Chip>{prop.name}</Chip>
              </th>
              <td class="py-3 pr-4">
                <div class="flex flex-wrap gap-1">
                  {prop.type.map((t) => (
                    <Chip>{t}</Chip>
                  ))}
                </div>
              </td>
              <td class="py-3">{prop.default ? <Chip>{prop.default}</Chip> : <span class="text-text-subtle">—</span>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
