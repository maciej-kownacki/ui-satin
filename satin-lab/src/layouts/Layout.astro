---
import { ClientRouter } from 'astro:transitions'
import '../styles/lab.css'
import { Customizer } from '../components/Customizer'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <!-- PNGs rendered from favicon.svg: Safari drops the SVG (its filters) and caches icons
         hard, so the files carry a version to bump when the icon changes. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png?v=2" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <!-- Pick the theme before the first paint, so dark mode never flashes light. -->
    <script is:inline>
      function satinTheme(doc) {
        try {
          const t = localStorage.getItem('satin-theme')
          const dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
          doc.documentElement.classList.toggle('dark', dark)
          // The customizer's brand, corners and type, as the same variables it writes live.
          const css = localStorage.getItem('satin-theme-css')
          if (css && !doc.getElementById('satin-custom')) {
            const el = doc.createElement('style')
            el.id = 'satin-custom'
            el.textContent = css
            doc.head.appendChild(el)
          }
        } catch {}
      }
      satinTheme(document)
      // Page changes swap in the next page's <html>; give it the theme before it is shown.
      document.addEventListener('astro:before-swap', (e) => satinTheme(e.newDocument))
    </script>
    <!-- Page changes happen in place: the sidebar and top bar stay, only the column changes. -->
    <ClientRouter fallback="none" />
  </head>
  <body class="relative min-h-dvh bg-bg-canvas antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-bg-popover focus:px-3 focus:py-2 focus:shadow-md"
    >
      Skip to content
    </a>
    <slot />
    <Customizer client:load transition:persist="customizer" />
  </body>
</html>
