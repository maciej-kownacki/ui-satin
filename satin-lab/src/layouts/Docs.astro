---
/**
 * Every page of the docs: the top bar (menu button on small screens, logo, Customize, Waitlist), then the
 * card with the sidebar and a 720px column. On wide screens the card runs edge to edge with 20px
 * either side and down to the bottom of the window.
 */
import Layout from './Layout.astro'
import { Sidebar } from '../components/Sidebar'
import { Customizer } from '../components/Customizer'
import { Button } from '@uisatin/ui'
import { nav, page } from '../nav'

interface Props {
  /** The nav item this page shows. */
  current: string
}
const { current } = Astro.props
const item = page(current)
const title = current === 'introduction' ? 'Satin' : `${item.title} · Satin`
---

<Layout title={title} description={item.description}>
  <!-- The top bar is fixed and never moves; the sidebar and the column each scroll on their own. -->
  <header class="fixed inset-x-0 top-0 z-20 flex h-14 w-full items-center justify-between bg-bg-canvas px-4 lg:px-9">
    <div class="flex items-center gap-2 pl-10 lg:pl-0">
      <a href="/" class="flex items-center gap-1.5 rounded-md focus-visible:shadow-border-focus focus-visible:outline-none">
        <span class="relative size-5 shrink-0">
          <img src="/figma/satin-logo.png" alt="" class="absolute inset-[-4.29%_-7.86%_-11.43%_-7.86%] block size-[calc(100%+15.72%)] max-w-none" />
        </span>
        <span class="text-[18px] leading-[19.5px] tracking-[-0.27px] text-text-default">satin</span>
      </a>
    </div>
    <div class="flex items-center gap-2">
      <Customizer client:load transition:persist="customizer" />
      <Button size="lg" shape="rounded">Waitlist</Button>
    </div>
  </header>

  <div
    data-docs-shell
    class="relative mt-14 flex min-h-[calc(100dvh-56px)] w-full overflow-clip bg-bg-card lg:fixed lg:inset-x-5 lg:top-14 lg:bottom-0 lg:z-30 lg:mt-0 lg:min-h-0 lg:w-auto lg:rounded-t-2xl lg:border lg:border-b-0 lg:border-border-subtle dark:lg:border-[color-mix(in_oklab,var(--border-subtle)_55%,var(--bg-card))] lg:shadow-[0_4px_6px_-4px_var(--effect-shadow-sm),0_10px_15px_-3px_var(--effect-shadow-sm)]"
  >
    <Sidebar client:load nav={nav} current={current} transition:persist="sidebar" />

    <main id="main" tabindex="-1" class="flex min-w-0 flex-1 flex-col items-center p-4 outline-none lg:overflow-y-auto lg:overscroll-contain">
      <div class="flex w-full max-w-[720px] flex-col gap-4 pb-24">
        <slot />
      </div>
    </main>
  </div>
</Layout>
