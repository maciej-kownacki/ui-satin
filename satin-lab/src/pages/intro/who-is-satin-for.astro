---
import Docs from '../../layouts/Docs.astro'
import PageHeader from '../../components/PageHeader.astro'
import { page } from '../../nav'
---

<Docs current="who-is-satin-for">
  <PageHeader title={page('who-is-satin-for').title} description={page('who-is-satin-for').description} />
  <ul class="flex flex-col gap-2 text-sm leading-[19.5px] text-text-muted">
    <li><span class="font-medium text-text-default">Designers</span> who work in the Satin Figma library and want to see how a component behaves before they use it.</li>
    <li><span class="font-medium text-text-default">Engineers</span> who need production code that matches the design without re-creating it by hand.</li>
    <li><span class="font-medium text-text-default">Teams building AI products</span> who need ready answers for prompts, agent progress and decisions.</li>
  </ul>
</Docs>
