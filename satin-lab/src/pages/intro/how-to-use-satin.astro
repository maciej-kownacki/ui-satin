---
import Docs from '../../layouts/Docs.astro'
import PageHeader from '../../components/PageHeader.astro'
import Chip from '../../components/Chip.astro'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const usage = `/* app.css */
@import "@satin/ui/styles.css";

// App.tsx
import { Button } from '@satin/ui/button'

export function Save() {
  return <Button>Save changes</Button>
}`
const usageHtml = (await highlight([{ id: 'x', label: '', code: usage }])).x
---

<Docs current="how-to-use-satin">
  <PageHeader id="how-to-use-satin" title={page('how-to-use-satin').title} description={page('how-to-use-satin').description} />
  <p class="text-sm leading-6 text-text-muted">
    Each component has its own entry point, so you only ship what you use. The package isn't on npm yet; until it is, it lives in the <Chip>packages/ui</Chip> folder of the Satin repository. Light and dark mode come from the <Chip>dark</Chip> class on any parent element.
  </p>
  <div class="code-block overflow-hidden rounded-2xl border border-border-subtle bg-bg-field" set:html={usageHtml} />
</Docs>
