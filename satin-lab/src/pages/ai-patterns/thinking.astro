---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import ThinkingDemo, { options } from '../../demos/thinking'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)

const item = {
  id: 'thinking',
  title: 'Thinking',
  href: '/ai-patterns/thinking',
  description: 'What an agent is doing while it works, folded into a summary when it is done.',
}

const api = {
  description: 'The `Thinking` component is a wrapper around the `details` element with a header and a rail of reasoning steps.',
  props: [
    { name: 'state', type: ['"loading"', '"collapsed"', '"expanded"'], default: '"loading"' },
    { name: 'label', type: ['string'], default: '"Thinking…"' },
    { name: 'time', type: ['string'] },
    { name: 'steps', type: ['ThinkingStep[]'], default: '[]' },
    { name: 'step.type', type: ['"task"', '"text"', '"source"', '"tool"', '"more"'], default: '"task"' },
    { name: 'onToggle', type: ['(open: boolean) => void'] },
  ],
}
---

<Docs current="thinking">
  <DocSection item={item} api={api}>
    <ThinkingDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
