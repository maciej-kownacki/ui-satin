---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import AttachmentDemo, { options } from '../../demos/attachment'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="attachment">
  <DocSection item={page('attachment')} api={api['attachment']}>
    <AttachmentDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
