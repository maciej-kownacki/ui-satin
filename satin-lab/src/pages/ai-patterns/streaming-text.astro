---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import StreamingTextDemo, { options } from '../../demos/streaming-text'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="streaming-text">
  <DocSection item={page('streaming-text')} api={api['streaming-text']}>
    <StreamingTextDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
