---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import AgentLoadingDemo, { options } from '../../demos/agent-loading'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="agent-loading">
  <DocSection item={page('agent-loading')} api={api['agent-loading']}>
    <AgentLoadingDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
