---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import AgentPickerDemo, { options } from '../../demos/agent-picker'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="agent-picker">
  <DocSection item={page('agent-picker')} api={api['agent-picker']}>
    <AgentPickerDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
