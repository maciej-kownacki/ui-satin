---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import DecisionCardDemo, { options } from '../../demos/decision-card'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="decision-card">
  <DocSection item={page('decision-card')} api={api['decision-card']}>
    <DecisionCardDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
