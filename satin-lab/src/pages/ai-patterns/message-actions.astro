---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import MessageActionsDemo, { options } from '../../demos/message-actions'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="message-actions">
  <DocSection item={page('message-actions')} api={api['message-actions']}>
    <MessageActionsDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
