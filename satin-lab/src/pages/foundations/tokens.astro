---
/**
 * The colour tokens from tokens/tokens.json, in the API Reference style: one table per role,
 * each token with its Light and Dark value side by side.
 */
import Docs from '../../layouts/Docs.astro'
import PageHeader from '../../components/PageHeader.astro'
import Chip from '../../components/Chip.astro'
import { page } from '../../nav'
import { colorGroups } from '../../lib/tokens'

const th = 'py-2 pr-4 text-left font-medium text-text-default'
const td = 'py-3 pr-4 align-middle'
---

<Docs current="tokens">
  <PageHeader title={page('tokens').title} description={page('tokens').description} />

  {
    colorGroups.map((g) => (
      <section aria-labelledby={`${g.role}-title`} class="flex flex-col gap-4 pt-8">
        <h2 id={`${g.role}-title`} class="text-base font-medium text-text-default">
          {g.title}
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[560px] border-collapse text-sm">
            <thead>
              <tr class="border-b border-border-default">
                <th scope="col" class={th}>Token</th>
                <th scope="col" class={`${th} w-[160px]`}>Light</th>
                <th scope="col" class={`${th} w-[160px] pr-0`}>Dark</th>
              </tr>
            </thead>
            <tbody>
              {g.tokens.map((t) => (
                <tr class="border-b border-border-default">
                  <th scope="row" class={`${td} text-left font-normal`}>
                    <Chip>{t.css}</Chip>
                  </th>
                  {[t.light, t.dark].map((value, i) => (
                    <td class={`${td} ${i === 1 ? 'pr-0' : ''}`}>
                      <span class="flex items-center gap-2">
                        <span
                          aria-hidden
                          class="size-5 shrink-0 rounded-md border border-border-default"
                          style={`background:${value}`}
                        />
                        <span class="font-mono text-text-muted">{value}</span>
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
</Docs>
