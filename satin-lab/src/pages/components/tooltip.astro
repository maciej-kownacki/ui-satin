---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import TooltipDemo, { options } from '../../demos/tooltip'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="tooltip">
  <DocSection
    item={{
      id: 'tooltip',
      title: 'Tooltip',
      href: '/components/tooltip',
      description: 'Names an icon-only control and shows the shortcut that runs it.',
    }}
    api={{
      description: 'The `Tooltip` component is a wrapper around the `div` element with role="tooltip", linked to its trigger.',
      props: [
        { name: 'label', type: ['string'] },
        { name: 'shortcut', type: ['string'] },
        { name: 'shape', type: ['"default"', '"rounded"'], default: '"default"' },
        { name: 'side', type: ['"top"', '"right"', '"bottom"', '"left"'], default: '"top"' },
        { name: 'delay', type: ['number'], default: '300' },
        { name: 'children', type: ['ReactNode'] },
      ],
    }}
  >
    <TooltipDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
