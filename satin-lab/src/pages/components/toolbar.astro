---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import ToolbarDemo, { options } from '../../demos/toolbar'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="toolbar">
  <DocSection item={page('toolbar')} api={api['toolbar']}>
    <ToolbarDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
