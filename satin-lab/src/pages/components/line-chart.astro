---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import LineChartDemo, { options } from '../../demos/line-chart'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="line-chart">
  <DocSection item={page('line-chart')} api={api['line-chart']}>
    <LineChartDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
