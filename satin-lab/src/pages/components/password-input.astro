---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import PasswordInputDemo, { options } from '../../demos/password-input'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="password-input">
  <DocSection item={page('password-input')} api={api['password-input']}>
    <PasswordInputDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
