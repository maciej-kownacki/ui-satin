---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import ProgressDemo, { options } from '../../demos/progress'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="progress">
  <DocSection item={page('progress')} api={api['progress']}>
    <ProgressDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
