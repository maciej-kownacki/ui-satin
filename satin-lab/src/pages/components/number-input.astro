---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import Demo, { options } from '../../demos/number-input'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="number-input">
  <DocSection item={page('number-input')} api={api['number-input']}>
    <Demo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
