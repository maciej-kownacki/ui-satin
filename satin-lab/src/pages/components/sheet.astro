---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import SheetDemo, { options } from '../../demos/sheet'
import { highlight } from '../../lib/highlight'
import { page } from '../../nav'

const codeHtml = await highlight(options)

const api = {
  description:
    "The `Sheet` component wraps the Radix dialog in a `div` with `role=\"dialog\"` that slides in from the right or the bottom. Wrap footer buttons in `SheetClose` to close it.",
  props: [
    {name: "side", type: ["\"right\"", "\"bottom\""], default: "\"right\""},
    {name: "trigger", type: ["ReactNode"]},
    {name: "title", type: ["ReactNode"]},
    {name: "description", type: ["ReactNode"]},
    {name: "children", type: ["ReactNode"]},
    {name: "footer", type: ["ReactNode"]},
    {name: "open", type: ["boolean"]},
    {name: "onOpenChange", type: ["(open: boolean) => void"]},
  ],
}
---

<Docs current="sheet">
  <DocSection item={page('sheet')} api={api}>
    <SheetDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
