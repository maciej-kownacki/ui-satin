---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import ChannelChartDemo, { options } from '../../demos/channel-chart'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="channel-chart">
  <DocSection item={page('channel-chart')} api={api['channel-chart']}>
    <ChannelChartDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
