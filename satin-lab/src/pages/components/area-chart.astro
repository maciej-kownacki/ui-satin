---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import AreaChartDemo, { options } from '../../demos/area-chart'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="area-chart">
  <DocSection item={page('area-chart')} api={api['area-chart']}>
    <AreaChartDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
