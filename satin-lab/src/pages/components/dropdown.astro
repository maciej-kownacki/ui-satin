---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import DropdownDemo, { options } from '../../demos/dropdown'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="dropdown">
  <DocSection item={page('dropdown')} api={api['dropdown']}>
    <DropdownDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
