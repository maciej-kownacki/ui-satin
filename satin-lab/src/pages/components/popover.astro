---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import PopoverDemo, { options } from '../../demos/popover'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="popover">
  <DocSection item={page('popover')} api={api['popover']}>
    <PopoverDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
