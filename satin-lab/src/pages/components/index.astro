---
/**
 * All components: every component and AI pattern page as a card with a preview, like a
 * catalogue. Each preview is the page's own demo, live and scaled to the card (CardPreview),
 * loaded as the card comes into view, so it is the real component at any resolution, in the
 * current theme and brand. The search and the group filter are one small island.
 */
import Docs from '../../layouts/Docs.astro'
import PageHeader from '../../components/PageHeader.astro'
import { ComponentFilter } from '../../components/ComponentFilter'
import { CardPreview } from '../../components/CardPreview'
import { allComponents, nav, pagesOf } from '../../nav'

const groups = nav.filter((g) => g.id === 'components' || g.id === 'ai-patterns')
const cards = groups.flatMap((g) =>
  pagesOf(g.items).map((p) => ({
    ...p,
    group: g.id,
    groupTitle: g.id === 'ai-patterns' ? 'AI pattern' : 'Component',
  })),
)
// The whole card is the link (the title's link stretched over it), so the live preview inside
// isn't nested in an <a>; the card shows the link's focus ring.
const card =
  'relative flex flex-col rounded-2xl border border-border-subtle bg-bg-card transition-[border-color,box-shadow] duration-(--duration-fast) ease-(--ease-out) hover:border-border-default hover:[box-shadow:0_4px_6px_-1px_var(--effect-shadow-sm),0_2px_4px_-2px_var(--effect-shadow-sm)] has-[a:focus-visible]:shadow-border-focus'
---

<Docs current={allComponents.id} wide>
  <PageHeader id={allComponents.id} title={allComponents.title} description={`${cards.length} components and AI patterns, each with its props, accessibility notes and code to copy.`} crumbs={[{ label: 'Components' }, { label: allComponents.title }]} />

  <div class="pt-6">
    <ComponentFilter client:load groups={groups.map((g) => ({ value: g.id, label: g.title }))} />
  </div>

  <ul class="grid grid-cols-1 gap-4 pt-2 sm:grid-cols-2 xl:grid-cols-3" aria-label="Components">
    {
      cards.map((c) => (
        <li data-card data-group={c.group} data-title={c.title.toLowerCase()}>
          <article class={card}>
            <div class="relative aspect-[16/10] rounded-t-[15px] border-b border-border-subtle bg-bg-field [clip-path:inset(0_round_15px_15px_0_0)]">
              <CardPreview client:visible={{ rootMargin: '300px' }} id={c.id} />
            </div>
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <a href={c.href} class="truncate text-base font-medium text-text-default outline-none after:absolute after:inset-0 after:content-['']">
                {c.title}
              </a>
              <span class="shrink-0 text-sm text-text-muted">{c.groupTitle}</span>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
  <p data-cards-empty hidden class="py-12 text-center text-sm text-text-muted">No components match.</p>
</Docs>
