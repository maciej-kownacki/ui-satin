---
/**
 * All components: every component and AI pattern page as a card with a preview, like a
 * catalogue. The previews are shots of each page's own stage, in Light and Dark
 * (public/thumbs, made by scripts/thumbs.mjs), so they show what the page shows. The search
 * and the group filter are one small island; the cards are plain links.
 */
import Docs from '../../layouts/Docs.astro'
import PageHeader from '../../components/PageHeader.astro'
import { ComponentFilter } from '../../components/ComponentFilter'
import { allComponents, nav, pagesOf } from '../../nav'

const groups = nav.filter((g) => g.id === 'components' || g.id === 'ai-patterns')
const thumbs = new Set(Object.keys(import.meta.glob('/public/thumbs/*-light.webp')).map((f) => f.replace(/^.*\/(.+)-light\.webp$/, '$1')))
const cards = groups.flatMap((g) =>
  pagesOf(g.items).map((p) => ({
    ...p,
    group: g.id,
    groupTitle: g.id === 'ai-patterns' ? 'AI pattern' : 'Component',
    thumb: thumbs.has(p.id),
  })),
)
const card =
  'group flex flex-col overflow-clip rounded-2xl border border-border-subtle bg-bg-card transition-[border-color,box-shadow] duration-(--duration-fast) ease-(--ease-out) hover:border-border-default hover:[box-shadow:0_4px_6px_-1px_var(--effect-shadow-sm),0_2px_4px_-2px_var(--effect-shadow-sm)] focus-visible:shadow-border-focus focus-visible:outline-none'
---

<Docs current={allComponents.id} wide>
  <PageHeader id={allComponents.id} title={allComponents.title} description={`${cards.length} components and AI patterns, each with its props, accessibility notes and code to copy.`} crumbs={[{ label: 'Components' }, { label: allComponents.title }]} />

  <div class="pt-6">
    <ComponentFilter client:load groups={groups.map((g) => ({ value: g.id, label: g.title }))} />
  </div>

  <ul class="grid grid-cols-1 gap-4 pt-2 sm:grid-cols-2 xl:grid-cols-3" aria-label="Components">
    {
      cards.map((c) => (
        <li data-card data-group={c.group} data-title={c.title.toLowerCase()}>
          <a href={c.href} class={card}>
            <div class="relative aspect-[16/10] overflow-clip border-b border-border-subtle bg-bg-field">
              {c.thumb ? (
                <>
                  <img src={`/thumbs/${c.id}-light.webp`} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-contain dark:hidden" />
                  <img src={`/thumbs/${c.id}-dark.webp`} alt="" loading="lazy" decoding="async" class="absolute inset-0 hidden size-full object-contain dark:block" />
                </>
              ) : (
                <span class="absolute inset-0 grid place-items-center text-sm text-text-muted">{c.title}</span>
              )}
            </div>
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <span class="truncate text-base font-medium text-text-default">{c.title}</span>
              <span class="shrink-0 text-sm text-text-muted">{c.groupTitle}</span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  <p data-cards-empty hidden class="py-12 text-center text-sm text-text-muted">No components match.</p>
</Docs>
