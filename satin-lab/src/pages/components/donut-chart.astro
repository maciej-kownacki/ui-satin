---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import DonutChartDemo, { options } from '../../demos/donut-chart'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="donut-chart">
  <DocSection item={page('donut-chart')} api={api['donut-chart']}>
    <DonutChartDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
