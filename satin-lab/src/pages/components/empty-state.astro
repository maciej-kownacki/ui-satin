---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import EmptyStateDemo, { options } from '../../demos/empty-state'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="empty-state">
  <DocSection item={page('empty-state')} api={api['empty-state']}>
    <EmptyStateDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
