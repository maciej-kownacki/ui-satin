---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import AccordionDemo, { options } from '../../demos/accordion'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="accordion">
  <DocSection item={page('accordion')} api={api['accordion']}>
    <AccordionDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
