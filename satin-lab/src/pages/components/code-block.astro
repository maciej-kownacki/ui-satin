---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import CodeBlockDemo, { options } from '../../demos/code-block'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="code-block">
  <DocSection
    item={{
      id: 'code-block',
      title: 'Code block',
      href: '/components/code-block',
      description: 'Shows code or a diff with a filename, line numbers and a copy button.',
    }}
    api={{
      description: 'The `CodeBlock` component is a wrapper around the `pre` element that adds a filename header, line numbers and diff colours.',
      props: [
        { name: 'code', type: ['string'] },
        { name: 'filename', type: ['string'] },
        { name: 'view', type: ['"code"', '"diff"'], default: '"code"' },
        { name: 'showHeader', type: ['boolean'], default: 'true' },
        { name: 'showActions', type: ['boolean'], default: 'true' },
        { name: 'highlightLines', type: ['number[]'], default: '[]' },
      ],
    }}
  >
    <CodeBlockDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
