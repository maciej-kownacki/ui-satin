---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import SidebarDemo, { options } from '../../demos/sidebar'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="sidebar">
  <DocSection item={page('sidebar')} api={api['sidebar']}>
    <SidebarDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
