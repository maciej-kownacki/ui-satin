---
import Docs from '../../layouts/Docs.astro'
import DocSection from '../../components/DocSection.astro'
import StepperDemo, { options } from '../../demos/stepper'
import { api } from '../../api'
import { page } from '../../nav'
import { highlight } from '../../lib/highlight'

const codeHtml = await highlight(options)
---

<Docs current="stepper">
  <DocSection item={page('stepper')} api={api['stepper']}>
    <StepperDemo client:load codeHtml={codeHtml} />
  </DocSection>
</Docs>
