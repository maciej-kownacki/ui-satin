---
import Docs from '../layouts/Docs.astro'
import PageHeader from '../components/PageHeader.astro'
import { page } from '../nav'
---

<Docs current="what-is-satin">
  <PageHeader title={page('what-is-satin').title} description={page('what-is-satin').description} />
  <div class="flex flex-col gap-3 text-sm leading-[19.5px] text-text-muted">
    <p>Satin ships as a Figma library and as React components that match it one to one: same names, same variants, same tokens.</p>
    <p>
      The components are built on <a class="text-text-default underline underline-offset-2" href="https://ui.shadcn.com">shadcn/ui</a> and Radix, so focus, keyboard and screen-reader behaviour come from proven primitives. Satin changes how they look: colour, surfaces, borders, focus and motion all come from Satin tokens.
    </p>
  </div>
</Docs>
