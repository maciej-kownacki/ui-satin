---
/**
 * Installation: the npm package in three lines, a prompt that has a coding agent do the same,
 * and the shadcn CLI folded away for those who want to own the source. Component pages carry only
 * their own install and import; everything shared lives here.
 */
import Docs from '../layouts/Docs.astro'
import PageHeader from '../components/PageHeader.astro'
import Chip from '../components/Chip.astro'
import { page } from '../nav'
import CodeFrame from '../components/CodeFrame.astro'

const componentsJson = `{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "utils": "@/lib/utils",
    "hooks": "@/hooks"
  }
}`
const alias = `// tsconfig.json (and tsconfig.app.json in Vite apps)
"compilerOptions": {
  "paths": { "@/*": ["./src/*"] }
}

// vite.config.ts
resolve: { alias: { '@': path.resolve(import.meta.dirname, 'src') } }`
const registryUsage = `// main.tsx, once for the whole app
import './styles/satin.css'

// App.tsx
import { Button } from '@/components/ui/button'

export function Save() {
  return <Button>Save changes</Button>
}`
const packageUsage = `// main.tsx (app/layout.tsx in Next.js), once for the whole app
import '@uisatin/ui/styles.css'

// App.tsx
import { Button } from '@uisatin/ui/button'

export function Save() {
  return <Button>Save changes</Button>
}`
const agentPrompt = `Set up the Satin design system (https://uisatin.dev) in this React project.

1. Check the project uses React 19 or newer. Satin doesn't need Tailwind; don't add it.
2. Install the package: npm i @uisatin/ui
3. Import the styles once at the app's entry point (main.tsx, or app/layout.tsx in Next.js): import '@uisatin/ui/styles.css'
4. Load the Geist and Geist Mono fonts, or the system font is used.
5. For dark mode, put the "dark" class on any parent element.
6. Import each component from its own entry point, for example: import { Button } from '@uisatin/ui/button'. The components are listed at https://uisatin.dev/r/registry.json and documented at https://uisatin.dev. They're marked 'use client', so Next.js Server Components can render them.
7. Use the components as they come. Colour, radius, type and motion come from Satin's tokens; don't restyle them with raw values.

When you're done, render a Button to check the styles load, and tell me what you set up.`
const h2 = 'text-lg font-medium text-text-default'
const prose = 'text-base leading-6 text-text-muted'
const link = 'rounded-sm text-text-default underline underline-offset-2 focus-visible:shadow-border-focus focus-visible:outline-none'
---

<Docs current="installation">
  <PageHeader id="installation" title={page('installation').title} description={page('installation').description} />

  <section aria-labelledby="npm-title" class="flex flex-col gap-3 pt-4">
    <h2 id="npm-title" class={h2}>Install from npm</h2>
    <p class={prose}>
      Satin needs React 19. No Tailwind, no config: <Chip>@uisatin/ui</Chip> ships compiled components and one precompiled stylesheet.
    </p>
    <CodeFrame code="npm i @uisatin/ui" label="Terminal" lang="bash" copyLabel="Copy command" />
    <CodeFrame code={packageUsage} label="Usage" />
    <p class={prose}>
      Each component has its own import, shown on its page. They're marked <Chip>'use client'</Chip>, so Next.js Server Components can render them. For dark mode, put the <Chip>dark</Chip> class on any parent. Load Geist and Geist Mono, or the system font is used.
    </p>
  </section>

  <section aria-labelledby="agent-title" class="flex flex-col gap-3 pt-10">
    <h2 id="agent-title" class={h2}>Or let your agent do it</h2>
    <p class={prose}>Paste this into Claude Code, Cursor or any coding agent working in your repository.</p>
    <CodeFrame code={agentPrompt} label="Prompt" lang="md" copyLabel="Copy prompt" wrap />
  </section>

  <section aria-labelledby="shadcn-title" class="flex flex-col gap-3 pt-10">
    <details class="group flex flex-col gap-3">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-sm text-lg font-medium text-text-default outline-none focus-visible:shadow-border-focus [&::-webkit-details-marker]:hidden">
        <span id="shadcn-title">Own the source with the shadcn CLI</span>
        <svg aria-hidden width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-text-muted transition-transform duration-(--duration-fast) ease-(--ease-out) group-open:rotate-180"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </summary>
      <div class="flex flex-col gap-3 pt-3">
        <p class={prose}>
          To change components' code, copy them into your project from the <a class={link} href="https://ui.shadcn.com/docs/registry">shadcn registry</a> instead. Set the project up once: add the <Chip>@/</Chip> alias and a <Chip>components.json</Chip> (written by hand: <Chip>shadcn init</Chip> stops without Tailwind, and Satin doesn't need it). Then each component page has its own command under Installation.
        </p>
        <CodeFrame code={alias} label="Import alias" />
        <CodeFrame code={componentsJson} label="components.json" lang="json" />
        <CodeFrame code={registryUsage} label="Usage" />
      </div>
    </details>
  </section>

  <p class:list={[prose, 'pt-10']}>
    Satin Free is open source under the MIT license; use it in any project, commercial ones included. Satin Pro will come as a separate package.
  </p>
</Docs>
