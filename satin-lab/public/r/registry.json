    {
      "name": "satin-styles",
      "type": "registry:item",
      "title": "Satin styles",
      "description": "Satin tokens, motion and every class the components use, precompiled. Import it once (for example in main.tsx); wrap a subtree in `.dark` for dark mode. No Tailwind needed.",
      "files": [
        {
          "path": "registry/satin/styles/satin.css",
          "type": "registry:file",
          "target": "~/src/styles/satin.css"
        }
      ]
    },
