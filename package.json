{
  "name": "ui-satin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "satin-lab"
  ],
  "scripts": {
    "dev": "npm run dev -w satin-lab",
    "build": "npm run build -w satin-lab",
    "tokens": "node tokens/build.mjs",
    "typecheck": "npm run typecheck -w @uisatin/ui",
    "build:ui": "npm run build -w @uisatin/ui",
    "registry": "npm run build -w @uisatin/ui && node --no-warnings registry/build.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release": "node scripts/release.mjs",
    "pack:ui": "npm run build:ui && npm pack ./packages/ui/dist --pack-destination ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
