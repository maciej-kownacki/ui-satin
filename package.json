{
  "name": "ui-satin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "satin-lab"
  ],
  "scripts": {
    "dev": "npm run dev -w satin-lab",
    "build": "npm run build -w satin-lab",
    "tokens": "node tokens/build.mjs",
    "typecheck": "npm run typecheck -w @uisatin/ui && npm run typecheck -w @uisatin/pro",
    "test": "vitest run",
    "build:ui": "npm run build -w @uisatin/ui",
    "registry": "npm run build -w @uisatin/ui && npm run build -w @uisatin/pro && node scripts/props.mjs && node scripts/sizes.mjs && node --no-warnings registry/build.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --no-audit --no-fund && npm run registry",
    "release": "node scripts/release.mjs",
    "pack:ui": "npm run build:ui && npm pack ./packages/ui/dist --pack-destination .",
    "check:types": "node scripts/check-types.mjs",
    "size": "size-limit",
    "props": "node scripts/props.mjs",
    "check:docs": "node scripts/props.mjs --check && node --no-warnings scripts/check-docs.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "build:pro": "npm run build -w @uisatin/pro"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "size-limit": "^14.3.0",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  }
}
