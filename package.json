{
  "name": "ui-satin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "satin-lab"
  ],
  "scripts": {
    "dev": "npm run dev -w satin-lab",
    "build": "npm run build -w satin-lab",
    "tokens": "node tokens/build.mjs",
    "typecheck": "npm run typecheck -w @uisatin/ui",
    "build:ui": "npm run build -w @uisatin/ui",
    "registry": "npm run build -w @uisatin/ui && node scripts/props.mjs && node scripts/sizes.mjs && node --no-warnings registry/build.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --no-audit --no-fund && npm run registry",
    "release": "node scripts/release.mjs",
    "pack:ui": "npm run build:ui && npm pack ./packages/ui/dist --pack-destination .",
    "check:types": "node scripts/check-types.mjs",
    "size": "size-limit",
    "props": "node scripts/props.mjs",
    "check:docs": "node scripts/props.mjs --check && node --no-warnings scripts/check-docs.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "playwright-core": "^1.65.1",
    "size-limit": "^14.3.0"
  }
}
